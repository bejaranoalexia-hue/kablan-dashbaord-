# Copy this file to .env.local and fill in both values to connect your Google Sheet.
# Leave them empty to use demo data stored in your browser.
# After changing this file, stop (Ctrl+C) and restart `npm run dev`.

# The Web app URL from Apps Script (Deploy -> Manage deployments). Ends in /exec
VITE_SHEET_URL=

# Any long random text. Must match SECRET in the Apps Script.
VITE_SHEET_KEY=
