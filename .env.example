# Copy this file to .env.local and fill in the values to connect your Google Sheet.
# These values stay on the server: they are never sent to the browser.
# After changing .env.local, stop (Ctrl+C) and restart `npm run dev`.
# When hosting on Vercel, add the same names under Project Settings -> Environment Variables.

# The Web app URL from Apps Script (Deploy -> Manage deployments). Ends in /exec
SHEET_URL=

# Any long random text. Must match the SECRET script property in Apps Script.
SHEET_KEY=

# Password for the login screen. Optional locally (empty = no login on localhost).
# Required when hosted online: without it the hosted board refuses all access.
APP_PASSWORD=
